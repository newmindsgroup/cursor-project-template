# Example environment variables (safe to commit)
# Never commit real secrets. Use a secret manager or local `.env` file.

APP_NAME="Cursor Starter Template Project"
ENV="development"
API_BASE_URL="http://localhost:3000"
LOG_LEVEL="info"

# Optional placeholders
SENTRY_DSN=""
ANALYTICS_KEY=""

# ============================================
# AI API Keys (set at least one)
# ============================================

# OpenAI API Key - https://platform.openai.com/api-keys
# Best for: Content generation, copywriting, general tasks
OPENAI_API_KEY=""

# Anthropic API Key - https://console.anthropic.com/
# Best for: Analysis, strategy, complex reasoning
ANTHROPIC_API_KEY=""

# Google AI API Key - https://makersuite.google.com/app/apikey
# Best for: Fast tasks, cost-effective generation
GOOGLE_AI_KEY=""

# NanoBanana AI Image Generation
# Get your API key from https://nanobanana.ai/api
NANOBANANA_API_KEY=""
# Project ID for usage tracking (optional, creates unique billing context per project)
NANOBANANA_PROJECT_ID=""

# ============================================
# AI Model Preferences (optional overrides)
# ============================================

# Content generation model (headlines, copy, content)
# Options: gpt-4-turbo-preview, claude-3-opus-20240229, gemini-1.5-pro
AI_CONTENT_MODEL=""

# Analysis model (business context, SEO, accessibility)
# Options: claude-3-opus-20240229, gpt-4-turbo-preview
AI_ANALYSIS_MODEL=""

# Quick tasks model (scoring, validation, fast generation)
# Options: gpt-3.5-turbo, claude-3-haiku-20240307, gemini-1.5-flash
AI_QUICK_MODEL=""

# Image generation model
# Options: gemini-2.5-flash (via NanoBanana)
AI_IMAGE_MODEL=""

# ============================================
# AI Configuration (optional)
# ============================================

# Default temperature for AI responses (0.0-1.0)
# Lower = more deterministic, Higher = more creative
AI_TEMPERATURE="0.7"

# Maximum tokens for AI responses
AI_MAX_TOKENS="4096"

# Retry attempts for failed API calls
AI_MAX_RETRIES="3"

# ============================================
# Deployment (optional)
# ============================================

# Vercel deployment token
# Get from: https://vercel.com/account/tokens
VERCEL_TOKEN=""

# GitHub token for repository operations
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=""

# ============================================
# Docker Configuration (for docker-compose)
# ============================================

# Node environment
NODE_ENV="development"

# Vite dev server port (default 5173)
VITE_PORT="5173"
