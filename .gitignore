# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
logs/

# Temp
/tmp/
/.cache/

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Project settings (contains API keys)
project-settings.local.json

# Cursor AI fallback prompts
.cursor-prompts/

# Build outputs (generic)
dist/
build/
.next/
.out/
coverage/

# Prototype Kit - generated handoff files (track structure, not generated content)
/_handoff/elementor-map.json
/_handoff/elementor-map.md
/_handoff/assets/*
!/_handoff/assets/.gitkeep

# AI-generated images (regenerate with npm run assets:generate)
/.image-cache/
/src/assets/generated/*
!/src/assets/generated/.gitkeep

# Generation cache (for incremental builds)
/.generation-cache/

# Content backups
/.content-backups/

# Dependencies (generic)
node_modules/
vendor/

# Python artifacts
.venv/
__pycache__/

# Reference folders (local-only)
/business-context/*
!/business-context/.gitkeep
!/business-context/README.md
!/business-context/uploads/
/business-context/uploads/*
!/business-context/uploads/.gitkeep
/business-context/extracted-context.json
/resource-library/*
!/resource-library/.gitkeep
!/resource-library/README.md
