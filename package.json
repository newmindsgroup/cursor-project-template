{
  "name": "cursor-prototype-starter-kit",
  "version": "1.0.0",
  "type": "module",
  "description": "Modern frontend prototype system with automated Elementor handoff",
  "scripts": {
    "start": "node scripts/start.mjs",
    "help": "node scripts/help.mjs",
    "commands": "node scripts/help.mjs",
    "show-commands": "node scripts/help.mjs",
    "list": "node scripts/help.mjs",
    "options": "node scripts/help.mjs",
    "?": "node scripts/help.mjs",
    "dev": "vite",
    "dev:watch": "node scripts/dev-watch.mjs",
    "dev:watch:content": "node scripts/dev-watch.mjs --content",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.js",
    "format": "prettier --write \"src/**/*.{ts,js,html,css}\"",
    "handoff:export": "node scripts/export-handoff.mjs",
    "handoff:zips": "node scripts/generate-zips.mjs",
    "handoff:screenshots": "node scripts/take-screenshots.mjs",
    "handoff:bundle": "npm run assets:generate && npm run build && npm run handoff:export && npm run handoff:zips && npm run handoff:screenshots",
    "content:export-csv": "node scripts/export-content-csv.mjs",
    "content:export-md": "node scripts/export-content-md.mjs",
    "content:bundle": "npm run content:export-csv && npm run content:export-md",
    "sitemap:export-wpcli": "node scripts/export-sitemap-wp-cli.mjs",
    "sitemap:export-xml": "node scripts/export-sitemap-xml.mjs",
    "sitemap:export-json": "node scripts/export-sitemap-json.mjs",
    "sitemap:export-guide": "node scripts/export-sitemap-guide.mjs",
    "sitemap:export-all": "npm run sitemap:export-wpcli && npm run sitemap:export-xml && npm run sitemap:export-json && npm run sitemap:export-guide",
    "progress:scan": "node scripts/scan-progress.mjs",
    "progress:scan:verbose": "node scripts/scan-progress.mjs --verbose",
    "project:build": "npm run progress:scan && npm run build",
    "project:bundle": "npm run progress:scan && npm run handoff:bundle",
    "page:generate": "node scripts/generate-page.mjs",
    "theme:apply": "node scripts/apply-theme.mjs",
    "theme:list": "node scripts/apply-theme.mjs --list",
    "assets:placeholders": "node scripts/generate-placeholders.mjs --all",
    "assets:generate": "node scripts/generate-images.mjs",
    "assets:generate:force": "node scripts/generate-images.mjs --force",
    "assets:generate:status": "node scripts/generate-images.mjs --status",
    "assets:generate:dry-run": "node scripts/generate-images.mjs --dry-run",
    "content:import": "node scripts/import-content.mjs",
    "content:optimize": "node scripts/optimize-seo.mjs",
    
    "ai:analyze-business": "node scripts/analyze-business-context.mjs",
    "ai:generate-personas": "node scripts/generate-personas.mjs",
    "ai:generate-flows": "node scripts/generate-user-flows.mjs",
    "ai:generate-content": "node scripts/generate-section-content.mjs",
    "ai:generate-colors": "node scripts/generate-brand-colors.mjs",
    "ai:generate-tests": "node scripts/generate-test-cases.mjs",
    "ai:optimize-headlines": "node scripts/optimize-headlines.mjs",
    "ai:optimize-seo": "node scripts/optimize-seo.mjs",
    "ai:check-accessibility": "node scripts/check-accessibility.mjs",
    "ai:visual-qa": "node scripts/visual-qa.mjs",
    "visual-diff": "node scripts/visual-diff.mjs",
    "visual-diff:baseline": "node scripts/visual-diff.mjs --baseline",
    "visual-diff:compare": "node scripts/visual-diff.mjs --compare",
    "ai:translate": "node scripts/translate-content.mjs",
    
    "ai:discovery": "npm run ai:analyze-business && npm run ai:generate-personas",
    "ai:ux": "npm run ai:generate-flows && npm run ai:generate-tests",
    "ai:content": "npm run ai:generate-content && npm run ai:optimize-headlines",
    "ai:content:parallel": "node scripts/generate-section-content.mjs --apply --parallel",
    "ai:content:quality": "node scripts/generate-section-content.mjs --apply --parallel --refine",
    "ai:design": "npm run ai:generate-colors",
    "ai:qa": "npm run ai:check-accessibility && npm run ai:visual-qa && npm run ai:optimize-seo",
    "ai:full-pipeline": "npm run ai:discovery && npm run ai:ux && npm run ai:content && npm run ai:design && npm run ai:qa",
    
    "settings": "node scripts/manage-settings.mjs",
    "settings:show": "node scripts/manage-settings.mjs --show",
    "settings:test": "node scripts/manage-settings.mjs --test",
    
    "validate": "node scripts/validate-all.mjs",
    "validate:all": "node scripts/validate-all.mjs",
    "validate:content": "node scripts/validate-all.mjs --content",
    "validate:assets": "node scripts/validate-all.mjs --assets",
    "validate:html": "node scripts/validate-all.mjs --html",
    "validate:schemas": "node scripts/validate-all.mjs --schemas",
    "validate:build": "node scripts/validate-build.mjs",
    "validate:design": "node scripts/validate-design.mjs",
    "validate:design:responsive": "node scripts/validate-design.mjs --responsive --verbose",
    "validate:design:strict": "node scripts/validate-design.mjs --strict --verbose",
    
    "lint:design": "node scripts/lint-design.mjs",
    "lint:design:staged": "node scripts/lint-design.mjs --staged",
    
    "test:visual": "node scripts/visual-breakpoint-test.mjs",
    "test:visual:open": "node scripts/visual-breakpoint-test.mjs --open",
    
    "generate:all": "node scripts/generate-all.mjs",
    
    "init": "node scripts/init-project.mjs",
    
    "report": "node scripts/build-report.mjs",
    "report:open": "node scripts/build-report.mjs --open",
    "report:json": "node scripts/build-report.mjs --json",
    
    "tokens:export": "node scripts/export-tokens.mjs",
    "tokens:export:json": "node scripts/export-tokens.mjs --format=json",
    "tokens:export:scss": "node scripts/export-tokens.mjs --format=scss",
    "tokens:export:figma": "node scripts/export-tokens.mjs --format=figma",
    
    "deploy": "node scripts/deploy-vercel.mjs",
    "deploy:preview": "node scripts/deploy-vercel.mjs --preview",
    "deploy:staging": "node scripts/deploy.mjs --env=staging",
    "deploy:production": "node scripts/deploy.mjs --env=production",
    "setup:github": "node scripts/setup-github.mjs",
    "setup:vercel": "node scripts/setup-vercel.mjs",
    
    "audit:performance": "node scripts/audit-performance.mjs",
    
    "pipeline:full": "npm run validate && npm run ai:full-pipeline && npm run project:bundle && npm run report",
    "pipeline:quick": "npm run ai:content && npm run build && npm run validate",
    "pipeline:qa": "npm run validate && npm run ai:qa && npm run audit:performance && npm run report",
    
    "wizard": "npm run wizard:server -- --open",
    "wizard:server": "node scripts/wizard-server.mjs",
    "wizard:check": "node scripts/check-gaps.mjs",
    "wizard:parse": "node scripts/parse-uploads.mjs",
    "wizard:generate": "node scripts/generate-all.mjs",
    
    "demo": "node scripts/setup-demo.mjs --business=wellness-center",
    "demo:wellness": "node scripts/setup-demo.mjs --business=wellness-center",
    "demo:reset": "node scripts/reset-demo.mjs",
    
    "reset:all": "node scripts/reset-all.mjs",
    "reset:confirm": "node scripts/reset-all.mjs --confirm"
  },
  "dependencies": {
    "gsap": "^3.12.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.1",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "archiver": "^6.0.1",
    "autoprefixer": "^10.4.17",
    "cors": "^2.8.5",
    "eslint": "^8.56.0",
    "express": "^4.18.2",
    "jsdom": "^24.0.0",
    "mammoth": "^1.6.0",
    "multer": "^1.4.5-lts.1",
    "open": "^10.0.0",
    "pdf-parse": "^1.1.1",
    "postcss": "^8.4.33",
    "prettier": "^3.2.4",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vite-plugin-html": "^3.2.2",
    "xlsx": "^0.18.5"
  }
}
