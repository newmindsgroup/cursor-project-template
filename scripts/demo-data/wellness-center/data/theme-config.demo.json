{
  "$schema": "../../../src/data/schemas/theme-config.schema.json",
  "name": "Serenity Wellness",
  "description": "Calming spa theme with natural, earthy tones",
  "colors": {
    "primary": {
      "50": "#f0fdf4",
      "100": "#dcfce7",
      "200": "#bbf7d0",
      "300": "#86efac",
      "400": "#4ade80",
      "500": "#6B8E6B",
      "600": "#5A7A5A",
      "700": "#4A664A",
      "800": "#3D533D",
      "900": "#2D3E2D"
    },
    "secondary": {
      "50": "#fefce8",
      "100": "#fef9c3",
      "200": "#fef08a",
      "300": "#fde047",
      "400": "#facc15",
      "500": "#D4AF37",
      "600": "#B8962F",
      "700": "#9A7D27",
      "800": "#7C641F",
      "900": "#5E4B17"
    },
    "neutral": {
      "50": "#FDFBF7",
      "100": "#FAF7F0",
      "200": "#F5EFE4",
      "300": "#E8DFD0",
      "400": "#D4C9B8",
      "500": "#A69B8C",
      "600": "#786D60",
      "700": "#5A5048",
      "800": "#3D3530",
      "900": "#1F1A18"
    }
  },
  "typography": {
    "fontFamily": {
      "heading": "Cormorant Garamond, Georgia, serif",
      "body": "Lato, -apple-system, BlinkMacSystemFont, sans-serif"
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem",
      "5xl": "3rem",
      "6xl": "3.75rem"
    }
  },
  "spacing": {
    "section": "5rem",
    "component": "2rem",
    "element": "1rem"
  },
  "borderRadius": {
    "sm": "0.25rem",
    "default": "0.5rem",
    "lg": "1rem",
    "full": "9999px"
  },
  "shadows": {
    "sm": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
    "default": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)",
    "md": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
    "lg": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)"
  },
  "images": {
    "style": "natural, soft lighting, peaceful environments",
    "subjects": ["spa treatments", "natural elements", "wellness", "relaxation"],
    "mood": "serene, calming, luxurious yet approachable"
