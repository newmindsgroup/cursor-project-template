{
  "$schema": "./design-rules.schema.json",
  "version": "1.0.0",
  "description": "Centralized design rules for spacing, sizing, and Golden Ratio enforcement",
  
  "spacing": {
    "section": {
      "description": "Vertical padding for content sections",
      "mobile": {
        "min": "64px",
        "class": "py-16",
        "rem": "4rem"
      },
      "tablet": {
        "min": "80px",
        "class": "md:py-20",
        "rem": "5rem"
      },
      "desktop": {
        "min": "96px",
        "class": "lg:py-24",
        "rem": "6rem"
      },
      "combined": "py-16 md:py-20 lg:py-24"
    },
    "sectionSmall": {
      "description": "Vertical padding for compact sections (logos, stats)",
      "mobile": {
        "min": "48px",
        "class": "py-12",
        "rem": "3rem"
      },
      "tablet": {
        "min": "64px",
        "class": "md:py-16",
        "rem": "4rem"
      },
      "desktop": {
        "min": "80px",
        "class": "lg:py-20",
        "rem": "5rem"
      },
      "combined": "py-12 md:py-16 lg:py-20"
    },
    "sectionLarge": {
      "description": "Vertical padding for hero/CTA sections",
      "mobile": {
        "min": "80px",
        "class": "py-20",
        "rem": "5rem"
      },
      "tablet": {
        "min": "128px",
        "class": "md:py-32",
        "rem": "8rem"
      },
      "desktop": {
        "min": "160px",
        "class": "lg:py-40",
        "rem": "10rem"
      },
      "combined": "py-20 md:py-32 lg:py-40"
    },
    "container": {
      "description": "Horizontal padding to prevent edge-touching",
      "mobile": {
        "min": "32px",
        "class": "px-8",
        "rem": "2rem"
      },
      "tablet": {
        "min": "48px",
        "class": "md:px-12",
        "rem": "3rem"
      },
      "desktop": {
        "min": "64px",
        "class": "lg:px-16",
        "rem": "4rem"
      },
      "combined": "px-8 md:px-12 lg:px-16"
    },
    "maxWidth": {
      "default": "max-w-7xl",
      "narrow": "max-w-5xl",
      "wide": "max-w-screen-2xl",
      "content": "max-w-3xl"
    }
  },

  "goldenRatio": {
    "phi": 1.618034,
    "phiInverse": 0.618034,
    "phiSquared": 2.618034,
    "phiCubed": 4.236068,
    "major": "61.8%",
    "minor": "38.2%",
    "aspectRatios": {
      "landscape": "1.618 / 1",
      "portrait": "1 / 1.618",
      "wide": "2.618 / 1"
    },
    "spacing": {
      "xs": "0.618rem",
      "sm": "0.764rem",
      "base": "1rem",
      "md": "1.236rem",
      "lg": "1.618rem",
      "xl": "2.618rem",
      "2xl": "4.236rem",
      "3xl": "6.854rem",
      "4xl": "11.09rem"
    },
    "typography": {
      "xs": "0.618rem",
      "sm": "0.764rem",
      "base": "1rem",
      "lg": "1.236rem",
      "xl": "1.618rem",
      "2xl": "2.618rem",
      "3xl": "4.236rem",
      "4xl": "6.854rem"
    }
  },

  "typography": {
    "hierarchy": {
      "display": {
        "desktop": "text-7xl",
        "tablet": "md:text-6xl",
        "mobile": "text-5xl"
      },
      "h1": {
        "desktop": "lg:text-7xl",
        "tablet": "md:text-6xl",
        "mobile": "text-5xl"
      },
      "h2": {
        "desktop": "md:text-5xl",
        "mobile": "text-4xl"
      },
      "h3": {
        "desktop": "md:text-4xl",
        "mobile": "text-3xl"
      },
      "h4": {
        "desktop": "md:text-3xl",
        "mobile": "text-2xl"
      },
      "body": {
        "large": "text-xl",
        "default": "text-base",
        "small": "text-sm"
      }
    },
    "lineHeight": {
      "tight": "leading-tight",
      "snug": "leading-snug",
      "normal": "leading-normal",
      "relaxed": "leading-relaxed",
      "loose": "leading-loose"
    }
  },

  "components": {
    "card": {
      "padding": "p-8",
      "borderRadius": "rounded-2xl",
      "shadow": "shadow-soft",
      "gap": "gap-6"
    },
    "button": {
      "paddingLg": "px-8 py-4",
      "paddingMd": "px-6 py-3",
      "paddingSm": "px-4 py-2",
      "borderRadius": "rounded-lg"
    },
    "grid": {
      "gap": "gap-8",
      "gapLg": "lg:gap-12",
      "cols2": "md:grid-cols-2",
      "cols3": "lg:grid-cols-3",
      "cols4": "lg:grid-cols-4",
      "golden": "grid-cols-[38.2%_61.8%]",
      "goldenReverse": "grid-cols-[61.8%_38.2%]"
    }
  },

  "responsive": {
    "breakpoints": {
      "mobile": {
        "max": "767px",
        "label": "sm",
        "description": "Phones and small devices"
      },
      "tablet": {
        "min": "768px",
        "max": "1023px",
        "label": "md",
        "description": "Tablets and medium devices"
      },
      "desktop": {
        "min": "1024px",
        "label": "lg",
        "description": "Laptops and large screens"
      },
      "wide": {
        "min": "1280px",
        "label": "xl",
        "description": "Wide desktop monitors"
      }
    },
    "requiredPatterns": {
      "sectionPadding": {
        "description": "Section vertical padding must scale across breakpoints",
        "pattern": "py-{mobile} md:py-{tablet} lg:py-{desktop}",
        "examples": [
          "py-16 md:py-20 lg:py-24",
          "py-12 md:py-16 lg:py-20",
          "py-20 md:py-32 lg:py-40"
        ]
      },
      "containerPadding": {
        "description": "Container horizontal padding must scale across breakpoints",
        "pattern": "px-{mobile} md:px-{tablet} lg:px-{desktop}",
        "examples": [
          "px-8 md:px-12 lg:px-16",
          "px-6 md:px-8 lg:px-12"
        ]
      },
      "gridColumns": {
        "description": "Grids should use mobile-first approach (single column base)",
        "pattern": "grid-cols-1 md:grid-cols-{tablet} lg:grid-cols-{desktop}",
        "examples": [
          "grid-cols-1 md:grid-cols-2 lg:grid-cols-3",
          "grid-cols-1 md:grid-cols-2 lg:grid-cols-4",
          "grid-cols-1 lg:grid-cols-[61.8%_38.2%]"
        ]
      },
      "typography": {
        "description": "Headings should scale across breakpoints",
        "patterns": {
          "h1": "text-4xl md:text-5xl lg:text-6xl",
          "h2": "text-3xl md:text-4xl lg:text-5xl",
          "h3": "text-2xl md:text-3xl lg:text-4xl"
        }
      },
      "gaps": {
        "description": "Grid gaps should scale on larger screens",
        "pattern": "gap-{mobile} lg:gap-{desktop}",
        "examples": [
          "gap-8 lg:gap-12",
          "gap-6 lg:gap-8"
        ]
      }
    },
    "goldenRatioResponsive": {
      "description": "Golden Ratio splits should stack on mobile",
      "mobile": "grid-cols-1",
      "desktop": "lg:grid-cols-[61.8%_38.2%]",
      "combined": "grid-cols-1 lg:grid-cols-[61.8%_38.2%] gap-8 lg:gap-12"
    }
  },

  "validation": {
    "requiredSectionClasses": [
      "py-16",
      "py-12",
      "py-20"
    ],
    "requiredContainerClasses": [
      "px-8",
      "px-6"
    ],
    "requiredMaxWidthClasses": [
      "max-w-7xl",
      "max-w-6xl",
      "max-w-5xl",
      "max-w-4xl",
      "max-w-3xl"
    ],
    "forbiddenPatterns": [
      "px-4(?!\\s|$)",
      "px-2",
      "p-4(?!\\s|$)",
      "p-2"
    ],
    "minimumPadding": {
      "horizontal": 32,
      "vertical": 48
    },
    "responsiveRequired": {
      "sectionPadding": true,
      "containerPadding": true,
      "gridStacking": true,
      "typographyScaling": true
    }
  },

  "presets": {
    "sectionStandard": {
      "outer": "py-16 md:py-20 lg:py-24",
      "container": "max-w-7xl mx-auto px-8 md:px-12 lg:px-16",
      "description": "Standard content section"
    },
    "sectionCompact": {
      "outer": "py-12 md:py-16 lg:py-20",
      "container": "max-w-7xl mx-auto px-8 md:px-12 lg:px-16",
      "description": "Compact section for logos, stats"
    },
    "sectionHero": {
      "outer": "py-20 md:py-32 lg:py-40",
      "container": "max-w-7xl mx-auto px-8 md:px-12 lg:px-16",
      "description": "Hero and CTA sections"
    },
    "sectionFooter": {
      "outer": "py-16 md:py-20 lg:py-24",
      "container": "max-w-7xl mx-auto px-8 md:px-12 lg:px-16",
      "description": "Footer section"
    }
  }
}
