{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "navigation.schema.json",
  "title": "Navigation Configuration",
  "description": "Schema for website navigation structure including primary, secondary, utility, and mobile navigation",
  "type": "object",
  "required": ["version", "primary"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to this schema file"
    },
    "version": {
      "type": "string",
      "description": "Schema version",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "description": "Description of the navigation configuration"
    },
    "_usage": {
      "type": "object",
      "description": "Usage examples for different website types",
      "additionalProperties": {
        "type": "string"
      }
    },
    "primary": {
      "$ref": "#/definitions/navigationSection"
    },
    "secondary": {
      "$ref": "#/definitions/footerNavigation"
    },
    "utility": {
      "$ref": "#/definitions/utilityNavigation"
    },
    "mobile": {
      "$ref": "#/definitions/mobileNavigation"
    },
    "breadcrumbs": {
      "$ref": "#/definitions/breadcrumbConfig"
    }
  },
  "definitions": {
    "localizedString": {
      "type": "object",
      "description": "Localized string with language codes as keys",
      "properties": {
        "en": { "type": "string" },
        "es": { "type": "string" }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "navigationItem": {
      "type": "object",
      "required": ["pageId", "label"],
      "properties": {
        "pageId": {
          "type": "string",
          "description": "Unique page identifier"
        },
        "label": {
          "$ref": "#/definitions/localizedString"
        },
        "order": {
          "type": "integer",
          "description": "Display order"
        },
        "dropdown": {
          "type": "boolean",
          "description": "Whether this item has a dropdown menu"
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether this item is enabled",
          "default": true
        },
        "_note": {
          "type": "string",
          "description": "Internal note about this item"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/navigationItem"
          }
        }
      }
    },
    "navigationSection": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/definitions/localizedString"
        },
        "location": {
          "type": "string",
          "enum": ["header", "footer", "sidebar", "header-top"]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/navigationItem"
          }
        },
        "cta": {
          "type": "object",
          "properties": {
            "label": {
              "$ref": "#/definitions/localizedString"
            },
            "href": {
              "type": "string"
            },
            "style": {
              "type": "string",
              "enum": ["primary", "secondary", "outline"]
            },
            "variants": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "label": {
                    "$ref": "#/definitions/localizedString"
                  },
                  "href": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "footerNavigation": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/definitions/localizedString"
        },
        "location": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "$ref": "#/definitions/localizedString" },
              "_note": { "type": "string" },
              "pageIds": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "social": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "platform": { "type": "string" },
              "url": { "type": "string" },
              "icon": { "type": "string" }
            }
          }
        },
        "contact": {
          "type": "object",
          "properties": {
            "_note": { "type": "string" },
            "email": { "type": "string" },
            "phone": { "type": "string" },
            "address": { "$ref": "#/definitions/localizedString" }
          }
        },
        "newsletter": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "title": { "$ref": "#/definitions/localizedString" },
            "description": { "$ref": "#/definitions/localizedString" }
          }
        }
      }
    },
    "utilityNavigation": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/definitions/localizedString"
        },
        "location": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["language-switcher", "search", "account", "cart"]
              },
              "label": { "$ref": "#/definitions/localizedString" },
              "href": { "type": "string" },
              "_note": { "type": "string" }
            }
          }
        }
      }
    },
    "mobileNavigation": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/definitions/localizedString"
        },
        "inheritFrom": {
          "type": "string",
          "enum": ["primary", "secondary"]
        },
        "showCta": { "type": "boolean" },
        "showSocial": { "type": "boolean" },
        "showSearch": { "type": "boolean" },
        "showLanguageSwitcher": { "type": "boolean" }
      }
    },
    "breadcrumbConfig": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "homeLabel": { "$ref": "#/definitions/localizedString" },
        "separator": { "type": "string" }
      }
    }
  }
}
