{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "page-blueprints.schema.json",
  "title": "Page Blueprints",
  "description": "Schema for pre-defined page structures",
  "type": "object",
  "required": ["version", "blueprints"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string"
    },
    "blueprints": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/blueprint"
      }
    },
    "sectionLibrary": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/sectionDef"
      }
    }
  },
  "definitions": {
    "blueprint": {
      "type": "object",
      "required": ["name", "sections"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "requiredContent": {
          "type": "array",
          "items": { "type": "string" }
        },
        "seo": {
          "type": "object",
          "properties": {
            "titleTemplate": { "type": "string" },
            "descriptionHint": { "type": "string" }
          }
        }
      }
    },
    "sectionDef": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "template": { "type": "string" },
        "contentFields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "variants": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
