{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "project-settings.schema.json",
  "title": "Project Settings",
  "description": "Schema for project configuration including AI settings and project metadata",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to this schema file"
    },
    "_comment": {
      "type": "string",
      "description": "Internal comment about the file"
    },
    "_usage": {
      "type": "string",
      "description": "Usage instructions"
    },
    "ai": {
      "type": "object",
      "description": "AI provider configuration",
      "properties": {
        "apiKeys": {
          "type": "object",
          "description": "API keys for various AI providers",
          "properties": {
            "openai": {
              "type": "string",
              "description": "OpenAI API key"
            },
            "anthropic": {
              "type": "string",
              "description": "Anthropic API key"
            },
            "google": {
              "type": "string",
              "description": "Google AI API key"
            },
            "nanobanana": {
              "type": "string",
              "description": "NanoBanana API key"
            }
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "preferences": {
          "type": "object",
          "description": "AI model preferences",
          "properties": {
            "defaultProvider": {
              "type": "string",
              "description": "Default AI provider",
              "enum": ["auto", "openai", "anthropic", "google", "cursor"]
            },
            "provider": {
              "type": "string",
              "description": "Alias for defaultProvider"
            },
            "tier": {
              "type": "string",
              "description": "Model tier preference",
              "enum": ["standard", "premium", "economy"]
            },
            "contentModel": {
              "type": "string",
              "description": "Model to use for content generation"
            },
            "analysisModel": {
              "type": "string",
              "description": "Model to use for analysis tasks"
            },
            "quickModel": {
              "type": "string",
              "description": "Model to use for quick/simple tasks"
            },
            "imageModel": {
              "type": "string",
              "description": "Model to use for image generation"
            }
          }
        },
        "settings": {
          "type": "object",
          "description": "AI generation settings",
          "properties": {
            "temperature": {
              "type": "number",
              "description": "Temperature for AI generation",
              "minimum": 0,
              "maximum": 2,
              "default": 0.7
            },
            "maxTokens": {
              "type": "integer",
              "description": "Maximum tokens for AI responses",
              "minimum": 1,
              "default": 4096
            },
            "maxRetries": {
              "type": "integer",
              "description": "Maximum retry attempts",
              "minimum": 0,
              "default": 3
            },
            "useCursorFallback": {
              "type": "boolean",
              "description": "Whether to fallback to Cursor AI if other providers fail",
              "default": true
            }
          }
        }
      }
    },
    "project": {
      "type": "object",
      "description": "Project metadata",
      "properties": {
        "name": {
          "type": "string",
          "description": "Project name"
        },
        "client": {
          "type": "string",
          "description": "Client name"
        },
        "description": {
          "type": "string",
          "description": "Project description"
        },
        "industry": {
          "type": "string",
          "description": "Industry or sector"
        },
        "siteUrl": {
          "type": "string",
          "description": "Target website URL",
          "format": "uri"
        },
        "targetLanguages": {
          "type": "array",
          "description": "Target languages for content",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
          },
          "default": ["en"]
        }
      }
    },
    "deployment": {
      "type": "object",
      "description": "Deployment configuration",
      "properties": {
        "github": {
          "type": "object",
          "properties": {
            "repo": {
              "type": "string",
              "description": "GitHub repository (username/repo-name)"
            }
          }
        },
        "vercel": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "description": "Vercel deployment URL",
              "format": "uri"
            }
          }
        }
      }
    }
  }
}
