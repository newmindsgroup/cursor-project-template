{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "user-flows.schema.json",
  "title": "User Flows",
  "description": "Schema for user flows and journey maps",
  "type": "object",
  "required": ["version", "flows"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lastUpdated": {
      "type": "string"
    },
    "generatedBy": {
      "type": "string"
    },
    "flows": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/flow"
      }
    },
    "journeyMaps": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/journeyMap"
      }
    },
    "template": {
      "type": "object"
    }
  },
  "definitions": {
    "flow": {
      "type": "object",
      "required": ["id", "name", "steps"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^flow-"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "persona": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "entry": {
          "type": "object",
          "properties": {
            "screen": { "type": "string" },
            "path": { "type": "string" },
            "trigger": { "type": "string" }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["order", "screen", "action"],
            "properties": {
              "order": { "type": "integer", "minimum": 1 },
              "screen": { "type": "string" },
              "action": { "type": "string" },
              "element": { "type": "string" },
              "outcome": { "type": "string" },
              "emotionalState": {
                "type": "string",
                "enum": ["curious", "confident", "uncertain", "frustrated", "satisfied"]
              },
              "notes": { "type": "string" }
            }
          },
          "minItems": 1
        },
        "successState": {
          "type": "string"
        },
        "failureStates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "cause": { "type": "string" },
              "recovery": { "type": "string" },
              "prevention": { "type": "string" }
            }
          }
        },
        "metrics": {
          "type": "object",
          "properties": {
            "target": { "type": "string" },
            "tracking": { "type": "array", "items": { "type": "string" } },
            "kpis": { "type": "array", "items": { "type": "string" } }
          }
        },
        "optimizationOpportunities": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "journeyMap": {
      "type": "object",
      "required": ["id", "name", "phases"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^journey-"
        },
        "name": {
          "type": "string"
        },
        "persona": {
          "type": "string"
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "duration": { "type": "string" },
              "touchpoints": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "channel": { "type": "string" },
                    "action": { "type": "string" },
                    "emotion": { 
                      "type": "string",
                      "enum": ["positive", "neutral", "negative"]
                    },
                    "painPoints": { "type": "array", "items": { "type": "string" } },
                    "opportunity": { "type": "string" }
                  }
                }
              },
              "goals": { "type": "array", "items": { "type": "string" } },
              "questions": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "moments": {
          "type": "object",
          "properties": {
            "truth": { "type": "array", "items": { "type": "string" } },
            "delight": { "type": "array", "items": { "type": "string" } },
            "pain": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
